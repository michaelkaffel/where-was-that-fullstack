{
  "project": "Where Was That API",
  "type": "api-contract",
  "version": "1.0",
  "lastUpdated": "2026-09-14",
  "baseUrl": "/",
  "authentication": {
    "method": "JWT",
    "header": "Authorization: Bearer <token>"
  },

  "routes": {

    "users": {

      "POST /users/signup": {
        "description": "Create a new local user account",
        "authRequired": false,
        "requestBody": {
          "username": "string",
          "firstname": "string",
          "lastname": "string",
          "email": "string",
          "password": "string"
        },
        "response": {
          "success": true,
          "token": "jwt",
          "user": {
            "id": "string",
            "username": "string",
            "firstname": "string",
            "lastname": "string",
            "email": "string",
            "admin": false
          }
        },
        "statusCodes": [201, 400]
      },

      "POST /users/login": {
        "description": "Login with username and password",
        "authRequired": false,
        "requestBody": {
          "username": "string",
          "password": "string"
        },
        "response": {
          "success": true,
          "token": "jwt",
          "user": {
            "id": "string",
            "username": "string",
            "firstname": "string",
            "lastname": "string",
            "email": "string",
            "admin": false
          }
        },
        "statusCodes": [200, 401]
      },

      "PATCH /users/me": {
        "description": "Update the current user's own username, firstname, lastname, email, and/or password",
        "authRequired": true,
        "requestBody": {
          "username": "string, optional",
          "firstname": "string, optional",
          "lastname": "string, optional",
          "email": "string, optional",
          "currentPassword": "string, required if newPassword is present",
          "newPassword": "string, optional — rejected with 400 for Google-only accounts (no hash) or if currentPassword is missing/wrong"
        },
        "response": {
          "success": true,
          "user": {
            "id": "string",
            "username": "string",
            "firstname": "string",
            "lastname": "string",
            "email": "string",
            "admin": false,
            "hasPassword": "boolean"
          }
        },
        "statusCodes": [200, 400, 401, 404]
      },

      "DELETE /users/me": {
        "description": "Delete the current user's own account, cascading to their places and images",
        "authRequired": true,
        "statusCodes": [200, 404]
      },

      "GET /users": {
        "description": "List all users (admin only)",
        "authRequired": true,
        "adminRequired": true,
        "response": [
          {
            "id": "string",
            "username": "string",
            "firstname": "string",
            "lastname": "string",
            "admin": false
          }
        ],
        "statusCodes": [200, 403]
      },

      "GET /users/:userId": {
        "description": "Look up any user by id (admin only)",
        "authRequired": true,
        "adminRequired": true,
        "statusCodes": [200, 403, 404],
        "notes": "Previously gated by verifyUser only (no admin/ownership check), letting any authenticated user fetch any other user's full profile by id — fixed 2026-09-14 by adding verifyAdmin. No client code calls this route."
      },

      "PATCH /users/:userId": {
        "description": "Admin update of another user's username/email/admin role",
        "authRequired": true,
        "adminRequired": true,
        "status": "planned, not yet implemented",
        "needsReview": "Listed as a backend requirement for the admin-panel task in todo-backlog.json but not yet in completedFeatures — confirm current implementation status before treating this route as live."
      },

      "DELETE /users/:userId": {
        "description": "Delete user and all associated places/images",
        "authRequired": true,
        "adminRequired": true,
        "statusCodes": [200, 404]
      }
    },

    "oauth": {

      "GET /users/auth/google": {
        "description": "Start Google OAuth login flow",
        "authRequired": false,
        "response": "Redirect to Google"
      },

      "GET /users/auth/google/callback": {
        "description": "OAuth callback from Google",
        "authRequired": false,
        "response": "Redirect to frontend /oauth-success with JWT token"
      }

    },

    "places": {

      "GET /places": {
        "description": "Return all places belonging to the authenticated user",
        "authRequired": true,
        "response": [
          {
            "id": "string",
            "title": "string",
            "description": "string",
            "imageUrl": "string",
            "location": {
              "name": "string",
              "lat": "number | null",
              "lng": "number | null"
            },
            "dateVisited": "date",
            "favorite": "boolean",
            "kindOfPlace": "campsite | hike | overlook",
            "owner": {
              "id": "string",
              "username": "string"
            },
            "notes": []
          }
        ],
        "statusCodes": [200, 401]
      },

      "POST /places": {
        "description": "Create a new place",
        "authRequired": true,
        "contentType": "multipart/form-data",
        "requestBody": {
          "title": "string",
          "description": "string",
          "location": {
            "name": "string",
            "lat": "number",
            "lng": "number"
          },
          "dateVisited": "date",
          "kindOfPlace": "campsite | hike | overlook",
          "image": "file"
        },
        "response": {
          "id": "string",
          "title": "string",
          "imageUrl": "string"
        },
        "statusCodes": [201, 400]
      },

      "GET /places/:placeId": {
        "description": "Return a single place owned by the user",
        "authRequired": true,
        "statusCodes": [200, 403, 404]
      },

      "PATCH /places/:placeId": {
        "description": "Update favorite status",
        "authRequired": true,
        "requestBody": {
          "favorite": "boolean"
        },
        "statusCodes": [200, 400]
      },

      "DELETE /places/:placeId": {
        "description": "Delete place and associated image",
        "authRequired": true,
        "statusCodes": [200, 404]
      }

    },

    "notes": {

      "GET /places/:placeId/notes": {
        "description": "Return notes for a place",
        "authRequired": true,
        "response": [
          {
            "id": "string",
            "text": "string",
            "date": "string",
            "createdAt": "date",
            "updatedAt": "date"
          }
        ]
      },

      "POST /places/:placeId/notes": {
        "description": "Create a new note",
        "authRequired": true,
        "requestBody": {
          "text": "string",
          "date": "string"
        },
        "statusCodes": [201, 400]
      },

      "PATCH /places/:placeId/notes/:noteId": {
        "description": "Update note text",
        "authRequired": true,
        "requestBody": {
          "text": "string"
        },
        "statusCodes": [200, 400, 404]
      },

      "DELETE /places/:placeId/notes/:noteId": {
        "description": "Delete a note",
        "authRequired": true,
        "statusCodes": [200, 404]
      },

      "DELETE /places/:placeId/notes": {
        "description": "Delete all notes for a place",
        "authRequired": true,
        "statusCodes": [200]
      }

    }

  }
}